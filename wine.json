basis":"라벨","profile":{"body":3,"acid":4,"tannin":0,"sweet":0},"drink":"now","desc":"칠레 북부 리마리 밸리, 바다 가까운 석회암 밭(Caliza=석회암)의 샤르도네. 서늘한 바닷바람 덕에 산도와 짭짤한 미네랄 느낌이 살아 있는 편이다.","check":"빈티지 미확인 · 병목에 98점 스티커","count":1,"nv":false,"why":"산도와 과실이 중심인 칠레 샤르도네다. 오래 숙성하는 스타일이 아니라 2~3년 안에 마신다.","price":null,"pic":"wine_photos/C-0006.webp"},{"id":"C-0007","type":"white","producer":"Vides y Vinos Ossian","name":"Ossian","vintage":2022,"appellation":"Nieva, Segovia (Castilla y León)","country":"스페인","region":"castilla","grapes":["verdejo"],"grape_basis":"생산자 일반 정보","profile":{"body":4,"acid":3,"tannin":0,"sweet":0},"drink":"now","desc":"세고비아 니에바의 수령 높은 베르데호로 만들어 오크 통에서 발효·숙성한 화이트. 흔한 루에다 베르데호보다 묵직하고, 시트러스에 견과·허브 향이 겹친다.","check":"라벨: 2022 · Segovia","count":1,"nv":false,"why":"오크 숙성한 2022 베르데호다. 지금도 좋고 2~3년은 더 버틴다.","price":null,"pic":"wine_photos/C-0007.webp"},{"id":"C-0008","type":"red","producer":"Vincent Legou","name":"Vosne-Romanée","vintage":2022,"appellation":"Vosne-Romanée (Bourgogne)","country":"프랑스","region":"bourgogne","grapes":["pinot_noir"],"grape_basis":"산지 규정","profile":{"body":3,"acid":4,"tannin":3,"sweet":0},"drink":"soon","desc":"부르고뉴 본 로마네 마을 단위 피노 누아. 붉은 과실·향신료에 실크 같은 탄닌이 이 마을의 특징으로 꼽힌다. 아직 어려 2~3년 더 두면 향이 더 열린다.","check":"라벨: 2022 · Vosne-Romanée","count":1,"nv":false,"why":"2022 마을 단위 피노 누아다. 어릴 땐 향이 닫혀 있고 3~5년차쯤 열린다.","price":{"avg":120000,"n":1,"min":120000,"max":120000,"checked":"2026-11-22","basis":"수입사 제공가","memo":"우리 병과 같은 빈티지 가격은 못 찾았다(괄호 안이 그 가격의 빈티지, 표시 없으면 판매 페이지에 빈티지 없음). 판매처 가격은 못 찾았고, 와인21 에 수입사가 등록한 가격만 있다(등록 시점이 오래됐을 수 있다).","sources":[{"krw":120000,"source":"와인21(수입사 제공가)","url":"https://www.wine21.com/13_search/wine_view.html?Idx=159906","vintage":2018,"note":""}]},"pic":"wine_photos/C-0008.webp"},{"id":"C-0009","type":"red","producer":"Domaine Drouhin Oregon","name":"Laurène Pinot Noir","vintage":2023,"appellation":"Dundee Hills (Oregon)","country":"미국","region":"oregon","grapes":["pinot_noir"],"grape_basis":"라벨","profile":{"body":3,"acid":4,"tannin":2,"sweet":0},"drink":"soon","desc":"부르고뉴의 드루앵 가문이 오리건에 세운 도멘의 대표 퀴베(가문 딸 로렌의 이름). 체리·장미, 부르고뉴보다 과실이 조금 더 풍성하다. 어린 빈티지라 1~2년 두면 좋다.","check":"라벨: 2023 · Pinot Noir · Dundee Hills","count":1,"nv":false,"why":"2023 으로 아직 어리다. 1~2년 두면 과실과 산도가 어우러진다.","price":null,"pic":"wine_photos/C-0009.webp"},{"id":"C-0010","type":"red","producer":"G.D. Vajra","name":"Barolo Bricco delle Viole","vintage":2021,"appellation":"Barolo DOCG (Piemonte)","country":"이탈리아","region":"piemonte","grapes":["nebbiolo"],"grape_basis":"산지 규정","profile":{"body":4,"acid":4,"tannin":5,"sweet":0},"drink":"keep","desc":"바롤로 마을에서 가장 높은 언덕 밭 중 하나인 「제비꽃 언덕」. 제비꽃·장미·붉은 과실로 바롤로 중 우아한 편이지만 탄닌이 단단해 오래 둘수록 좋다.","check":"빈티지 2021 · 2병(오너 확인 11/22)","count":2,"nv":false,"why":"바롤로는 탄닌이 강해 보통 빈티지 뒤 8~10년부터 마신다. 2021 은 아직 이르다.","price":{"avg":129000,"n":1,"min":129000,"max":129000,"checked":"2026-11-22","basis":"판매가","memo":"우리 병과 같은 빈티지 가격은 못 찾았다(괄호 안이 그 가격의 빈티지, 표시 없으면 판매 페이지에 빈티지 없음).","sources":[{"krw":129000,"source":"데일리샷","url":"https://dailyshot.co/m/item/30548?item=511219","vintage":null,"note":""}]},"pic":"wine_photos/C-0010.webp"},{"id":"C-0011","type":"red","producer":"Fontodi","name":"Vigna del Sorbo Chianti Classico Gran Selezione","vintage":2021,"appellation":"Chianti Classico Gran Selezione (Panzano)","country":"이탈리아","region":"toscana","grapes":["sangiovese"],"grape_basis":"생산자 일반 정보","profile":{"body":4,"acid":5,"tannin":4,"sweet":0},"drink":"keep","desc":"판차노의 단일 밭 「비냐 델 소르보」. 키안티 클라시코 최상위 등급(그란 셀레치오네)이다. 체리·제비꽃·흙 내음, 산도와 탄닌이 단단해 몇 년 더 두면 좋다.","check":"라벨: 2021 · Gran Selezione · Panzano","count":1,"nv":false,"why":"그란 셀레치오네는 산도·탄닌이 단단한 장기 숙성형이다. 2021 은 몇 년 더 둔다.","price":{"avg":139000,"n":1,"min":139000,"max":139000,"checked":"2026-11-22","basis":"판매가","memo":"우리 병과 같은 빈티지 가격은 못 찾았다(괄호 안이 그 가격의 빈티지, 표시 없으면 판매 페이지에 빈티지 없음). 평균은 판매처 가격만으로 냈다. 와인21 수입사 등록가는 참고로만 아래에 둔다.","sources":[{"krw":139000,"source":"데일리샷","url":"https://dailyshot.co/m/item/14191","vintage":null,"note":""},{"krw":190000,"source":"와인21(수입사 제공가)","url":"https://www.wine21.com/13_search/wine_view.html?Idx=162004","vintage":2013,"note":""}]},"pic":"wine_photos/C-0011.webp"},{"id":"C-0012","type":"red","producer":"Fontodi","name":"Vigna del Sorbo Chianti Classico Gran Selezione","vintage":2019,"appellation":"Chianti Classico Gran Selezione (Panzano)","country":"이탈리아","region":"toscana","grapes":["sangiovese"],"grape_basis":"생산자 일반 정보","profile":{"body":4,"acid":5,"tannin":4,"sweet":0},"drink":"soon","desc":"같은 와인의 2019. 2021 보다 2년 더 익었다 — 두 병을 나란히 열어 빈티지를 비교하기 좋다.","check":"라벨: 2019 · Gran Selezione","count":1,"nv":false,"why":"같은 와인의 2019 다. 2021 보다 2년 더 익어 1~3년 안에 열기 좋다.","price":{"avg":139000,"n":1,"min":139000,"max":139000,"checked":"2026-11-22","basis":"판매가","memo":"우리 병과 같은 빈티지 가격은 못 찾았다(괄호 안이 그 가격의 빈티지, 표시 없으면 판매 페이지에 빈티지 없음). 평균은 판매처 가격만으로 냈다. 와인21 수입사 등록가는 참고로만 아래에 둔다.","sources":[{"krw":139000,"source":"데일리샷","url":"https://dailyshot.co/m/item/14191","vintage":null,"note":""},{"krw":190000,"source":"와인21(수입사 제공가)","url":"https://www.wine21.com/13_search/wine_view.html?Idx=162004","vintage":2013,"note":""}]},"pic":"wine_photos/C-0012.webp"},{"id":"C-0013","type":"red","producer":"Fontodi","name":"Flaccianello della Pieve","vintage":null,"appellation":"Colli della Toscana Centrale IGT","country":"이탈리아","region":"toscana","grapes":["sangiovese"],"grape_basis":"생산자 일반 정보","profile":{"body":5,"acid":4,"tannin":5,"sweet":0},"drink":"keep","desc":"폰토디의 대표 와인. 판차노에서 가장 좋은 구획의 산지오베제만으로 만든다. 진하고 구조가 커서 오래 둘수록 좋다.","check":"빈티지가 2020 으로 보이나 흐림 — 확인 필요","count":1,"nv":false,"why":"구조가 큰 산지오베제라 빈티지 뒤 10년 가까이 둬도 좋다. 빈티지를 못 읽어 일반적인 경향이다.","price":{"avg":340000,"n":1,"min":340000,"max":340000,"checked":"2026-11-22","basis":"판매가","memo":null,"sources":[{"krw":340000,"source":"데일리샷","url":"https://dailyshot.co/m/item/23405","vintage":2020,"note":""}]},"pic":"wine_photos/C-0013.webp"},{"id":"C-0014","type":"red","producer":"Tenuta di Trinoro","name":"Le Cupole","vintage":2021,"appellation":"Toscana IGT","country":"이탈리아","region":"toscana","grapes":["cabernet_franc","merlot"],"grape_basis":"생산자 일반 정보(해마다 비율 다름)","profile":{"body":4,"acid":3,"tannin":3,"sweet":0},"drink":"now","desc":"토스카나 남쪽 트리노로의 두 번째 와인. 카베르네 프랑과 메를로 중심의 보르도 품종 블렌드로 검은 과실이 진하고 탄닌이 부드러워 일찍 열어도 좋다.","check":"라벨: 2021 · Rosso Toscana","count":1,"nv":false,"why":"트리노로가 일찍 마시도록 만드는 두 번째 와인이다. 탄닌이 부드러워 지금 열어도 좋다.","price":{"avg":130000,"n":1,"min":130000,"max":130000,"checked":"2026-11-22","basis":"수입사 제공가","memo":"판매처 가격은 못 찾았고, 와인21 에 수입사가 등록한 가격만 있다(등록 시점이 오래됐을 수 있다).","sources":[{"krw":130000,"source":"와인21(수입사 제공가)","url":"https://www.wine21.com/13_search/wine_view.html?Idx=158882","vintage":2021,"note":""}]},"pic":"wine_photos/C-0014.webp"},{"id":"C-0015","type":"red","producer":"Dal Forno Romano","name":"Valpolicella Superiore Monte Lodoletta","vintage":2018,"appellation":"Valpolicella Superiore (Val d'Illasi, Veneto)","country":"이탈리아","region":"veneto","grapes":["corvina"],"grape_basis":"생산자 일반 정보(코르비나·코르비노네·론디넬라·오셀레타)","profile":{"body":5,"acid":3,"tannin":4,"sweet":1},"drink":"keep","desc":"포도를 일부 말려 농축한 뒤 만드는 달 포르노 로마노의 발폴리첼라. 보통 발폴리첼라와 달리 아마로네에 가까울 만큼 진하고 알코올이 높다. 한참 두고 여는 와인.","check":"라벨: Monte Lodoletta 2018 · Cellore d'Illasi · Verona","count":1,"nv":false,"why":"포도를 말려 만든 아주 진한 와인이다. 2018 이지만 10년 넘게 버티는 스타일이라 더 둘수록 좋다.","price":{"avg":520000,"n":1,"min":520000,"max":520000,"checked":"2026-11-22","basis":"수입사 제공가","memo":"우리 병과 같은 빈티지 가격은 못 찾았다(괄호 안이 그 가격의 빈티지, 표시 없으면 판매 페이지에 빈티지 없음). 판매처 가격은 못 찾았고, 와인21 에 수입사가 등록한 가격만 있다(등록 시점이 오래됐을 수 있다).","sources":[{"krw":520000,"source":"와인21(수입사 제공가)","url":"https://www.wine21.com/13_search/wine_view.html?Idx=146873","vintage":2015,"note":""}]},"pic":"wine_photos/C-0015.webp"},{"id":"C-0016","type":"red","producer":"Catena Zapata","name":"Malbec Argentino","vintage":2022,"appellation":"Mendoza","country":"아르헨티나","region":"mendoza","grapes":["malbec"],"grape_basis":"라벨","profile":{"body":5,"acid":4,"tannin":4,"sweet":0},"drink":"soon","d